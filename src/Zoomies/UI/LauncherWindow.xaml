<Window x:Class="Zoomies.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Zoomies.Localization"
        Title="Zoomies Quick Jump"
        Width="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        Background="{DynamicResource Brush.Launcher}"
        BorderBrush="{DynamicResource Brush.LauncherBorder}" BorderThickness="1">
    <Grid x:Name="Root" Background="{DynamicResource Brush.Launcher}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search box -->
        <Grid Margin="18,14,18,12">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="18" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock x:Name="Placeholder" Margin="36,0,0,0" FontSize="19" VerticalAlignment="Center" IsHitTestVisible="False"
                       Text="{l:T Launcher.Placeholder}" Foreground="{DynamicResource Brush.TextTertiary}" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="Query" Margin="34,0,0,0" FontSize="19" TextChanged="Query_TextChanged"
                     Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}"
                     SelectionBrush="{DynamicResource Brush.Accent}"
                     AutomationProperties.Name="{l:T Launcher.Placeholder}">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>

        <!-- Where results will open (File Explorer window or a Save/Open dialog) -->
        <Border x:Name="ContextChip" Grid.Row="1" Margin="18,0,18,10" CornerRadius="12" Padding="10,4"
                Background="{DynamicResource Brush.AccentSoft}" HorizontalAlignment="Left" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="&#xE8A7;" Foreground="{DynamicResource Brush.AccentText}" />
                <TextBlock x:Name="ContextText" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.AccentText}"
                           TextTrimming="CharacterEllipsis" MaxWidth="560" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}">
            <Grid>
                <ListBox x:Name="Results" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                         MaxHeight="468" Margin="8,6" PreviewMouseLeftButtonUp="Results_MouseUp"
                         AutomationProperties.Name="Results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.AccentSoft}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.AccentText}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextTertiary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Margin="22,16" Style="{StaticResource Caption}" FontSize="13" Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Divider}" Padding="18,8">
            <TextBlock x:Name="Footer" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Text="{l:T Launcher.Hints}" />
        </Border>
    </Grid>
</Window>
