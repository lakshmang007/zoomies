<UserControl x:Class="Zoomies.UI.Pages.WorkspacesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Zoomies.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,32,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Workspaces.Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Workspaces.Subtitle}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="NameBox" FontSize="14" MinHeight="34" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{l:T Workspaces.NamePlaceholder}" TextChanged="NameBox_TextChanged" />
                                <TextBlock x:Name="NamePlaceholder" Text="{l:T Workspaces.NamePlaceholder}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextTertiary}" />
                            </Grid>
                            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Content="{l:T Workspaces.Save}" Click="Save_Click" />
                        </Grid>
                        <TextBlock x:Name="OpenCount" Style="{StaticResource Caption}" FontSize="13" Margin="0,10,0,0" />
                        <TextBlock x:Name="SavedText" Style="{StaticResource Caption}" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.Success}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" Text="{l:T Workspaces.Empty}" Visibility="Collapsed" />
                <ItemsControl x:Name="List" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C4;" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="13" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Folders}" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextTertiary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Content="{l:T Workspaces.Open}" Click="Open_Click" />
                                        <Button Style="{StaticResource SubtleButton}" Content="{l:T Workspaces.Delete}" Click="Delete_Click" Margin="6,0,0,0"
                                                Foreground="{DynamicResource Brush.Danger}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
