<!-- Sand: the light theme. Warm ivory, very little chrome, a soft multi-colour glow, and one gradient accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solid accent for the built-in controls (checkboxes, radio buttons, focus lines). -->
    <Color x:Key="Color.Accent">#5B57E0</Color>
    <Color x:Key="Color.Caption">#FAF9F5</Color>
    <Color x:Key="Color.CaptionText">#1F1E1D</Color>

    <!-- Ivory with a faint blue / violet / rose glow in the corners. Drawn once and stretched to the window. -->
    <DrawingBrush x:Key="Brush.Background" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,100,100">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FAF9F5">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#2E8AB4F8" Offset="0" /><GradientStop Color="#008AB4F8" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="92,4" RadiusX="34" RadiusY="34" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#24C58AF9" Offset="0" /><GradientStop Color="#00C58AF9" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="72,-6" RadiusX="30" RadiusY="26" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#1CF6A5A0" Offset="0" /><GradientStop Color="#00F6A5A0" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="104,30" RadiusX="26" RadiusY="26" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#14FDD663" Offset="0" /><GradientStop Color="#00FDD663" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="0,104" RadiusX="34" RadiusY="26" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- The one bold element: Google-style blue → violet → rose, dark enough for white text. -->
    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#3367D6" Offset="0" />
        <GradientStop Color="#7B4FD1" Offset="0.55" />
        <GradientStop Color="#C2477A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2B5BC4" Offset="0" />
        <GradientStop Color="#6E44C0" Offset="0.55" />
        <GradientStop Color="#B03E6E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentPressed" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2550AD" Offset="0" />
        <GradientStop Color="#613BAA" Offset="0.55" />
        <GradientStop Color="#9C3661" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#4F4BCF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#F0EDE6" />

    <!-- No separate sidebar panel: the background runs through, with a hairline divider. -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.Inset" Color="#F6F4EE" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#ECE9E2" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#E9E6DF" />
    <SolidColorBrush x:Key="Brush.Text" Color="#1F1E1D" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#65635D" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#94928B" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#0A1F1E1D" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#141F1E1D" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#EFECE5" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#DEDAD1" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#C5352A" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#AD2C22" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE9E6" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2E7D4F" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E8F3EC" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FBF1DC" />
    <SolidColorBrush x:Key="Brush.Launcher" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.LauncherBorder" Color="#E2DED6" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#94928B" />
</ResourceDictionary>
