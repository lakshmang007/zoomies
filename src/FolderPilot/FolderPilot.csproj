<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FolderPilot</AssemblyName>
    <RootNamespace>FolderPilot</RootNamespace>
    <ApplicationIcon>Assets\FolderPilot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Low memory footprint: workstation GC without the background GC thread,
         and a GC that prefers compacting over growing the heap. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- WPF Fluent theme (ThemeMode) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderPilot.Core\FolderPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Content Include="Assets\FolderPilot.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Strings\*.json" LogicalName="FolderPilot.Strings.%(Filename).json" />
  </ItemGroup>

</Project>
