<UserControl x:Class="FolderPilot.UI.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FolderPilot.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,32,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="960" />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Cleanup.Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Cleanup.Subtitle}" />

                <WrapPanel Margin="0,0,0,16">
                    <RadioButton x:Name="TabUnused" Style="{StaticResource Segment}" GroupName="tabs" Tag="Unused" Content="{l:T Cleanup.Tab.Unused}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabDuplicates" Style="{StaticResource Segment}" GroupName="tabs" Tag="Duplicates" Content="{l:T Cleanup.Tab.Duplicates}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabLarge" Style="{StaticResource Segment}" GroupName="tabs" Tag="Large" Content="{l:T Cleanup.Tab.Large}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabInstallers" Style="{StaticResource Segment}" GroupName="tabs" Tag="Installers" Content="{l:T Cleanup.Tab.Installers}" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabEmpty" Style="{StaticResource Segment}" GroupName="tabs" Tag="Empty" Content="{l:T Cleanup.Tab.Empty}" Checked="Tab_Checked" />
                </WrapPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.LookIn}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ScopeText" Style="{StaticResource Body}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{l:T Cleanup.Change}" Click="ChooseFolder_Click" Margin="12,0,0,0" />
                            <Button x:Name="ResetScopeButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{l:T Cleanup.Reset}" Click="ResetScope_Click" Margin="6,0,0,0" />
                        </Grid>

                        <WrapPanel Margin="0,14,0,0">
                            <StackPanel x:Name="PeriodOption" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.NotUsedFor}" Margin="0,0,0,6" />
                                <ComboBox x:Name="PeriodBox" Width="170" AutomationProperties.Name="{l:T Cleanup.NotUsedFor}" />
                            </StackPanel>
                            <StackPanel x:Name="SizeOption">
                                <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.BiggerThan}" Margin="0,0,0,6" />
                                <ComboBox x:Name="SizeBox" Width="170" AutomationProperties.Name="{l:T Cleanup.BiggerThan}" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="{l:T Cleanup.Scan}" Click="Scan_Click" />
                            <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Content="{l:T Cleanup.Stop}" Click="Stop_Click" Margin="8,0,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="ProgressText" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="AccessNote" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="ResultsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResultSummary" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <WrapPanel x:Name="SelectionButtons" Grid.Column="1">
                                <Button x:Name="KeepOldestButton" Style="{StaticResource SubtleButton}" Content="{l:T Cleanup.KeepOldest}" Click="KeepOldest_Click" />
                                <Button Style="{StaticResource SubtleButton}" Content="{l:T Cleanup.SelectAll}" Click="SelectAll_Click" />
                                <Button Style="{StaticResource SubtleButton}" Content="{l:T Cleanup.SelectNone}" Click="SelectNone_Click" />
                            </WrapPanel>
                        </Grid>
                        <TextBlock x:Name="NoneFound" Style="{StaticResource Body}" Text="{l:T Cleanup.NoneFound}" Visibility="Collapsed" />

                        <StackPanel x:Name="ListArea">
                            <Grid Margin="8,4,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.Column.Name}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.Column.Folder}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.Column.Size}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="{l:T Cleanup.Column.LastUsed}" HorizontalAlignment="Right" />
                            </Grid>
                            <ListBox x:Name="Rows" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource StaticRow}" MaxHeight="440"
                                     MouseDoubleClick="Rows_MouseDoubleClick">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Items[0].GroupHeader}" Style="{StaticResource ColumnHeader}" Margin="8,12,0,2" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="5*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                                      AutomationProperties.Name="{Binding Name}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="{Binding Glyph}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                <TextBlock Text="{Binding Name}" Margin="10,0,8,0" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Folder}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding LastUsedText}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedText" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                <Button x:Name="RecycleButton" Grid.Column="1" Style="{StaticResource DangerButton}" Content="{l:T Cleanup.Recycle}" Click="Recycle_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DoneBanner" Style="{StaticResource Banner}" Background="{DynamicResource Brush.SuccessSoft}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock x:Name="DoneText" Grid.Column="1" Style="{StaticResource Body}" Margin="10,0" VerticalAlignment="Center" />
                        <Button x:Name="UndoButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{l:T Organize.Undo}" Click="Undo_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
