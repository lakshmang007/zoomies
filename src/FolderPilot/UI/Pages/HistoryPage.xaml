<UserControl x:Class="FolderPilot.UI.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FolderPilot.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,32,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T History.Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T History.Subtitle}" />
                <Border x:Name="ResultBanner" Style="{StaticResource Banner}" Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="ResultText" Style="{StaticResource Body}" />
                </Border>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" FontSize="13" Text="{l:T History.Empty}" Visibility="Collapsed" />
                <Border x:Name="ListCard" Style="{StaticResource Card}" Padding="8">
                    <ItemsControl x:Name="List" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}" Width="36" Height="36">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.AccentText}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{l:T History.Undo}" Click="Undo_Click"
                                            Visibility="{Binding UndoVisibility}" />
                                    <TextBlock Grid.Column="2" Text="{l:T History.Undone}" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               Visibility="{Binding UndoneVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
