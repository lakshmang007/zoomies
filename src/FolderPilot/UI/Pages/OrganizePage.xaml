<UserControl x:Class="FolderPilot.UI.Pages.OrganizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FolderPilot.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,32,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="920" />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Organize.Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Organize.Subtitle}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Folder}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" FontSize="14" MinHeight="34" VerticalContentAlignment="Center"
                                     KeyDown="FolderBox_KeyDown" AutomationProperties.Name="{l:T Organize.Folder}" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Content="{l:T Organize.Browse}" Click="Browse_Click" />
                        </Grid>
                        <WrapPanel x:Name="QuickFolders" Margin="0,10,0,0" />

                        <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Organize.SortBy}" Margin="0,8,0,6" />
                        <RadioButton x:Name="ModeByType" GroupName="mode" Content="{l:T Organize.Mode.ByType}" Margin="0,3" />
                        <RadioButton x:Name="ModeByTypeAndMonth" GroupName="mode" Content="{l:T Organize.Mode.ByTypeAndMonth}" Margin="0,3" />
                        <RadioButton x:Name="ModeByMonth" GroupName="mode" Content="{l:T Organize.Mode.ByMonth}" Margin="0,3" />
                        <CheckBox x:Name="KeepShortcuts" Content="{l:T Organize.KeepShortcuts}" IsChecked="True" Margin="0,12,0,0" />

                        <Button x:Name="PreviewButton" Style="{StaticResource PrimaryButton}" Content="{l:T Organize.Preview}"
                                Margin="0,18,0,0" Click="Preview_Click" />
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border x:Name="PlanCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <!-- The action sits next to the summary it applies to, so it's reachable without scrolling. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Summary" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <Button x:Name="ApplyButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{l:T Organize.Apply}" Click="Apply_Click" />
                        </Grid>
                        <ItemsControl x:Name="CategoryChips" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" Margin="0,0,8,8" Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="SkippedText" Style="{StaticResource Caption}" Margin="0,0,0,12" />

                        <!-- Search: type "stl" to see every .stl file and where that type goes -->
                        <Grid x:Name="SearchArea" Margin="0,0,0,12">
                            <TextBox x:Name="SearchBox" FontSize="14" MinHeight="34" VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{l:T Organize.Search}" />
                            <TextBlock x:Name="SearchPlaceholder" Text="{l:T Organize.Search}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextTertiary}" />
                        </Grid>

                        <!-- Where each file type goes: the user can rename any of these folders -->
                        <Border x:Name="TypesPanel" CornerRadius="8" Padding="14,12" Margin="0,0,0,14"
                                Background="{DynamicResource Brush.Inset}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" FontSize="14" Margin="0,0,0,2" Text="{l:T Organize.Types.Title}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10" Text="{l:T Organize.Types.Hint}" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Types.Column.Type}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Types.Column.Files}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Column.Size}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Types.Column.Folder}" />
                                </Grid>
                                <ScrollViewer MaxHeight="232" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl x:Name="TypeRows" Focusable="False">
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Visibility" Value="{Binding RowVisibility}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                    <TextBox Grid.Column="3" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" FontSize="13" MinHeight="30"
                                                             VerticalContentAlignment="Center" AutomationProperties.Name="{Binding FolderAutomationName}" />
                                                    <Button Grid.Column="4" Style="{StaticResource SubtleButton}" Content="{l:T Organize.Types.Reset}" Margin="6,0,0,0"
                                                            Visibility="{Binding ResetVisibility}" Click="ResetType_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="TypeError" Style="{StaticResource Caption}" Foreground="{DynamicResource Brush.Danger}" Margin="0,8,0,0"
                                           Text="{l:T Organize.Types.Invalid}" Visibility="Collapsed" />
                                <CheckBox x:Name="RememberBox" Content="{l:T Organize.Remember}" IsChecked="True" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="ListHeader" Margin="8,0,8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Column.Name}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Column.To}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{l:T Organize.Column.Size}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListBox x:Name="Moves" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource StaticRow}" MaxHeight="340">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="{Binding Glyph}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding Name}" Margin="10,0,8,0" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding To}" Foreground="{DynamicResource Brush.AccentText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoMatchText" Style="{StaticResource Caption}" FontSize="13" Margin="8,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border x:Name="DoneBanner" Style="{StaticResource Banner}" Background="{DynamicResource Brush.SuccessSoft}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource Brush.Success}" />
                        <TextBlock x:Name="DoneText" Grid.Column="1" Style="{StaticResource Body}" Margin="10,0" VerticalAlignment="Center" />
                        <Button x:Name="UndoButton" Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{l:T Organize.Undo}" Click="Undo_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
