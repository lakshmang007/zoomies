<UserControl x:Class="FolderPilot.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FolderPilot.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="40,32,40,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Title}" Margin="0,0,0,24" />

                <!-- Quick jump -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.QuickJump}" />
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Settings.Hotkey}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HotkeyBox" Width="240" FontSize="14" MinHeight="34" VerticalContentAlignment="Center" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"
                                     AutomationProperties.Name="{l:T Settings.Hotkey}" />
                            <Button x:Name="HotkeySave" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Content="{l:T Settings.Hotkey.Save}" Click="HotkeySave_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Caption}" Margin="0,6,0,10" Text="{l:T Settings.Hotkey.Hint}" />
                        <CheckBox x:Name="LearnSwitch" Style="{StaticResource Switch}" Content="{l:T Settings.Learn}" Click="Learn_Click" />
                    </StackPanel>
                </Border>

                <!-- Windows integration -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Integration}" />
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="{l:T Settings.Startup}" Click="Startup_Click" />
                        <CheckBox x:Name="MenuSwitch" Style="{StaticResource Switch}" Content="{l:T Settings.ContextMenu}" Click="Menu_Click" />
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T Settings.ContextMenu.Note}" />
                    </StackPanel>
                </Border>

                <!-- Search index -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Index}" />
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Settings.Index.Folders}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="RootsList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="14" Text="&#xE8B7;" Foreground="{DynamicResource Brush.AccentText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{l:T Settings.Index.Remove}" Click="RemoveRoot_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="DefaultRoots" Style="{StaticResource Body}" Text="{l:T Settings.Index.Default}" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T Settings.Index.Add}" Click="AddRoot_Click" />
                            <Button x:Name="ResetRoots" Style="{StaticResource SubtleButton}" Content="{l:T Settings.Index.Reset}" Click="ResetRoots_Click" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource ColumnHeader}" Text="{l:T Settings.Index.Skip}" Margin="0,0,0,6" />
                        <TextBox x:Name="SkipBox" FontSize="14" MinHeight="34" VerticalContentAlignment="Center" TextWrapping="Wrap"
                                 AutomationProperties.Name="{l:T Settings.Index.Skip}" />
                        <CheckBox x:Name="DotSwitch" Style="{StaticResource Switch}" Content="{l:T Settings.Index.SkipDot}" Margin="0,12,0,6" />
                        <CheckBox x:Name="HiddenSwitch" Style="{StaticResource Switch}" Content="{l:T Settings.Index.Hidden}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{l:T Settings.Index.Apply}" Click="ApplyIndex_Click" />
                            <TextBlock x:Name="IndexStatus" Style="{StaticResource Caption}" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Automation & performance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Automation}" />
                        <CheckBox x:Name="TidySwitch" Style="{StaticResource Switch}" Content="{l:T Settings.AutoTidy}" Click="Tidy_Click" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Performance}" Margin="0,18,0,10" />
                        <CheckBox x:Name="MemorySwitch" Style="{StaticResource Switch}" Content="{l:T Settings.LowMemory}" Click="Memory_Click" />
                        <TextBlock x:Name="MemoryNow" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <!-- Privacy & about -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Privacy}" />
                        <TextBlock Style="{StaticResource Body}" Text="{l:T Settings.Privacy.Body}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.About}" Margin="0,18,0,6" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Body}" />
                        <Button Style="{StaticResource SubtleButton}" Content="{l:T Settings.DataFolder}" Click="DataFolder_Click" Margin="-10,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
