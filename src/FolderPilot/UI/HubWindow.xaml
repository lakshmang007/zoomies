<Window x:Class="FolderPilot.UI.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FolderPilot.Localization"
        Title="FolderPilot" Width="1080" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Icon="/Assets/logo.png"
        Background="{DynamicResource Brush.Background}">
    <Grid x:Name="Root" Background="{DynamicResource Brush.Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                    <Image Source="/Assets/logo.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{l:T App.Name}" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" CornerRadius="8" Padding="12,10" Background="{DynamicResource Brush.AccentSoft}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="14" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Left" />
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Caption}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.AccentText}" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="Nav" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Navigation">
                    <ListBoxItem Tag="home" AutomationProperties.Name="{l:T Nav.Home}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" />
                            <TextBlock Text="{l:T Nav.Home}" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="organize" AutomationProperties.Name="{l:T Nav.Organize}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8CB;" />
                            <TextBlock Text="{l:T Nav.Organize}" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="cleanup" AutomationProperties.Name="{l:T Nav.Cleanup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" />
                            <TextBlock Text="{l:T Nav.Cleanup}" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="workspaces" AutomationProperties.Name="{l:T Nav.Workspaces}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7C4;" />
                            <TextBlock Text="{l:T Nav.Workspaces}" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="history" AutomationProperties.Name="{l:T Nav.History}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                            <TextBlock Text="{l:T Nav.History}" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="settings" AutomationProperties.Name="{l:T Nav.Settings}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                            <TextBlock Text="{l:T Nav.Settings}" Margin="12,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" />
    </Grid>
</Window>
