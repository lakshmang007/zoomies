<!-- Midnight: the dark theme. Near-black with a hint of deep blue and a soft moonlight accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Accent shades for the built-in (Fluent) controls are derived from this colour. -->
    <Color x:Key="Color.Accent">#8EA6FF</Color>
    <Color x:Key="Color.Caption">#05060A</Color>
    <Color x:Key="Color.CaptionText">#E9ECF3</Color>

    <LinearGradientBrush x:Key="Brush.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#05060A" Offset="0" />
        <GradientStop Color="#090C15" Offset="0.55" />
        <GradientStop Color="#0E1426" Offset="1" />
    </LinearGradientBrush>
    <!-- Translucent, so the background gradient carries through the sidebar. -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#59000000" />
    <SolidColorBrush x:Key="Brush.Inset" Color="#0B0F18" />
    <SolidColorBrush x:Key="Brush.Card" Color="#10141E" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#1E2433" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#1A202D" />
    <SolidColorBrush x:Key="Brush.Text" Color="#E9ECF3" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A2AABB" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#7A8396" />
    <!-- A light accent on near-black, so text on accent buttons is dark for contrast. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#8EA6FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#A2B6FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#7C95F0" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0A0F1F" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#172036" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#A9BBFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#1A2236" />
    <SolidColorBrush x:Key="Brush.Input" Color="#0C1019" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#2A3142" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF8A80" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#FF9E96" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A1D21" />
    <SolidColorBrush x:Key="Brush.Success" Color="#7BD88F" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#14271B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5C451" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#2E2614" />
    <SolidColorBrush x:Key="Brush.Launcher" Color="#0F131D" />
    <SolidColorBrush x:Key="Brush.LauncherBorder" Color="#283044" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#7D8698" />
</ResourceDictionary>
