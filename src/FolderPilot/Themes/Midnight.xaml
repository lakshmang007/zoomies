<!-- Midnight: the dark theme. Near-black, very little chrome, a soft multi-colour glow, and one gradient accent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Solid accent for the built-in controls (checkboxes, radio buttons, focus lines). -->
    <Color x:Key="Color.Accent">#A5A1FF</Color>
    <Color x:Key="Color.Caption">#0B0B0F</Color>
    <Color x:Key="Color.CaptionText">#ECECF1</Color>

    <!-- Midnight black with a faint blue / violet / rose glow in the corners. -->
    <DrawingBrush x:Key="Brush.Background" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,100,100">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0B0B0F">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#2E4285F4" Offset="0" /><GradientStop Color="#004285F4" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="92,4" RadiusX="34" RadiusY="34" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#269B72CB" Offset="0" /><GradientStop Color="#009B72CB" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="72,-6" RadiusX="30" RadiusY="26" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#1AD96570" Offset="0" /><GradientStop Color="#00D96570" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="104,30" RadiusX="26" RadiusY="26" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <RadialGradientBrush><GradientStop Color="#164285F4" Offset="0" /><GradientStop Color="#004285F4" Offset="1" /></RadialGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry><EllipseGeometry Center="0,104" RadiusX="34" RadiusY="26" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Lighter blue → violet → rose on black, with dark text for contrast. -->
    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#8AB4F8" Offset="0" />
        <GradientStop Color="#C58AF9" Offset="0.55" />
        <GradientStop Color="#F28B82" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentHover" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#A1C2FA" Offset="0" />
        <GradientStop Color="#D0A0FA" Offset="0.55" />
        <GradientStop Color="#F5A19A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentPressed" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#78A6F0" Offset="0" />
        <GradientStop Color="#B57AEF" Offset="0.55" />
        <GradientStop Color="#E57B73" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0B0B0F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#B4B1FF" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1C1C24" />

    <!-- No separate sidebar panel: the background runs through, with a hairline divider. -->
    <SolidColorBrush x:Key="Brush.Sidebar" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.Inset" Color="#111117" />
    <SolidColorBrush x:Key="Brush.Card" Color="#141419" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#23232B" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#1F1F26" />
    <SolidColorBrush x:Key="Brush.Text" Color="#ECECF1" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#74747E" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#1C1C24" />
    <SolidColorBrush x:Key="Brush.Input" Color="#0F0F14" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#2C2C35" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF8A80" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#FF9E96" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#341B1E" />
    <SolidColorBrush x:Key="Brush.Success" Color="#81D99B" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#14251A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5C451" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#2B2414" />
    <SolidColorBrush x:Key="Brush.Launcher" Color="#141419" />
    <SolidColorBrush x:Key="Brush.LauncherBorder" Color="#2A2A33" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#74747E" />
</ResourceDictionary>
