<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Background" Color="#1E1F22" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#191A1C" />
    <SolidColorBrush x:Key="Brush.Card" Color="#2A2B2F" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#36383D" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#33353A" />
    <SolidColorBrush x:Key="Brush.Text" Color="#F2F3F5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B3B8BF" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8D939B" />
    <!-- In dark mode the accent is lighter, so buttons use dark text on it for contrast. -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#7AA7FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8DB4FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#6A96EB" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0B1530" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#22324F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#93B8FF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#2C3A55" />
    <SolidColorBrush x:Key="Brush.Input" Color="#232427" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#45484E" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF8A80" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#FF9E96" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#46272A" />
    <SolidColorBrush x:Key="Brush.Success" Color="#7BD88F" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#233A2A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5C451" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#3D3420" />
    <SolidColorBrush x:Key="Brush.Launcher" Color="#26272B" />
    <SolidColorBrush x:Key="Brush.LauncherBorder" Color="#4A4D54" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#9AA0A8" />
</ResourceDictionary>
