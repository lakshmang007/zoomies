<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: builds a sample PC, drives Zoomies through a scripted demo and records the screen. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zoomies.Core\Zoomies.Core.csproj" />
  </ItemGroup>

</Project>
